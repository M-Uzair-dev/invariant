DATABASE_URL=postgresql://invariant:invariant@localhost:5433/invariant_test
REDIS_HOST=127.0.0.1
REDIS_PORT=6378
INACTIVE_SESSION_TTL_SECONDS=86400
SESSION_MAX_LIFETIME_SECONDS=2592000

PAYMENTS_EXPIRY_SECONDS = 86400 # one day
PAYMENT_PAGE_URL=https://google.com

# webhook worker: timer off (tests call sendRequests directly), short HTTP timeout,
# and allow http://127.0.0.1 receivers past the SSRF check
WEBHOOK_WORKER_INTERVAL_MS=0
WEBHOOK_HTTP_TIMEOUT_MS=1000
WEBHOOK_ALLOW_LOOPBACK=true
WEBHOOK_ALERT_INTERVAL_MS=0
